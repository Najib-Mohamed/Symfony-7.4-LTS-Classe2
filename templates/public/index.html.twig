{% extends 'base.html.twig' %}

{% block title %}Acceuil{% endblock %}

{% block body %}
    <style>
        .example-wrapper {
            margin: 1em auto;
            max-width: 800px;
            width: 95%;
            font: 18px/1.5 sans-serif;
        }
        .example-wrapper code {
            background: #f5f5f5;
            padding: 2px 6px;
        }
    </style>

    <div class="example-wrapper">
        {# pour afficher des variables, on utilise  {{var}}, pour afficher une action on utilise {%action%} #}
        <h1>salut {{ name }}, bienvenue dans la controller public ✅</h1>

        {# twig dans symfony protége par défaut contre les attaque xss (les script) #}
        {{ xss }}
        
        {% include "public/inc/menu.html.twig" %}
    </div>
{% endblock %}
